{
  "modules": {
    "generalDescription": {
      "tabText": "General Description",
      "fields": [
        {
          "localKey": "generalDescription",
          "label": "General Description",
          "type": "textarea",
          "required": true,
          "selector": "textarea[name='generalDescription']",
          "fallbackSelectors": [
            "xpath=(//*[normalize-space()='General Description']/following::textarea)[1]"
          ]
        },
        {
          "localKey": "confidentialComments",
          "label": "Confidential Comments",
          "type": "textarea",
          "required": false,
          "selector": "textarea[name='confidentialComments']",
          "fallbackSelectors": [
            "xpath=(//*[normalize-space()='Confidential Comments']/following::textarea)[1]"
          ]
        }
      ]
    },
    "report": {
      "tabText": "Report",
      "fields": []
    },
    "reportAttachments": {
      "tabText": "Report Attachments",
      "attachmentSelector": "input[type='file']",
      "uploadMode": "allFilesInFolder"
    }
  },
  "saveButton": {
    "selector": "button#saveButton:visible"
  }
}
